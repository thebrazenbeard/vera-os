temp_auto_push.bat
temp_interactive_push.bat

# Local Python tooling and disposable checkouts; keep source/tests trackable.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
.venv/
venv/
/dist/
/build/
*.egg-info/

# Operator secrets and local-only runtime state. Template files remain visible.
!.env.example
!.env.sample
!.env.*.example
!.env.*.sample
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm
*.db
*.db-wal
*.db-shm

